+
+IScreenLineLayout *ScreenLine::Shape(Surface *surface) const {
+	auto &data = *ll->bidiData;
+	for (const auto &cached : data.recent)
+		if (cached.layout && cached.start == start && cached.length == len)
+			return cached.layout.get();
+	auto &slot = data.recent[data.next++ % std::size(data.recent)];
+	slot = {start,len,surface->Layout(this)};
+	return slot.layout.get();
+}

+	CGContextSetTextPosition(context,x,y);
+	const auto firstIndex = CharacterIndex(start);
+	const auto endIndex = CharacterIndex(end);
+	auto it = std::lower_bound(clusters.begin(), clusters.end(), firstIndex,
+		[](const Cluster &c, CFIndex index) { return c.start < index; });
+	if (it != clusters.begin() && (it == clusters.end() || it->start > firstIndex))
+		--it;
+	while (it != clusters.end() && it->start < endIndex) {
+		const CTRunRef run = it->run;
+		CFIndex first = it->glyph, last = first;
+		++it;
+		while (it != clusters.end() && it->start < endIndex && it->run == run &&

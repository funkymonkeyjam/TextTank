+		return {Origin(begin),Origin(finish)};
+	}
+
+	size_t TileAtX(XYPOSITION x) const {
+		if (count==1) return 0;
+		if (line.BaseRightToLeft()) x = Origin(line.len)-x;
+		const Range bounds(line.start,line.start+line.len);
+		const Sci::Position pos = line.ll->FindPositionFromX(x+line.ll->GetPosition(line.start),bounds,true);
+		return TileAt(pos-line.start);
+	}
+
+	ScreenLine Tile(size_t i) const {
+		const size_t begin = Boundary(i);
+		return ScreenLine(line,begin,Boundary(i+1)-begin);
+	}
+
+public:
+	VisualLine(const ScreenLine &source, Surface *surface_) :
+		line(source,0,source.len), surface(surface_),
+		count(source.len<=wholeLineBytes ? 1 : (source.len+tileBytes-1)/tileBytes) {
+	}
+
+	std::pair<size_t,size_t> VisibleBytes(XYPOSITION left, XYPOSITION right, size_t) const override {
+		const size_t first = TileAtX(left), last = TileAtX(right);
+		return {Boundary(std::min(first,last)),Boundary(std::max(first,last)+1)};
+	}
+
+	size_t PositionFromX(XYPOSITION x, bool character) override {
+		const auto tile = Tile(TileAtX(x));
+		const size_t start = tile.start-line.start;
+		return start + tile.Shape(surface)->PositionFromX(x-TileSpan(start,start+tile.len).left,character);
+	}
+
+	XYPOSITION XFromPosition(size_t byte) override {
+		const auto tile = Tile(TileAt(byte));
+		const size_t start = tile.start-line.start;
+		return TileSpan(start,start+tile.len).left + tile.Shape(surface)->XFromPosition(byte-start);
+	}
+
+	std::vector<Interval> FindRangeIntervals(size_t start, size_t end) override {
+		if (start>=end) return {};
+		const size_t first = TileAt(start), last = TileAt(end-1);
+		std::vector<Interval> spans;
+		auto append = [&](size_t i) {
+			const auto tile = Tile(i);
+			const size_t begin = tile.start-line.start, finish = begin+tile.len;
+			if (count>1 && start<=begin && finish<=end) {
+				spans.push_back(TileSpan(begin,finish));
+			} else {
+				for (Interval part : tile.Shape(surface)->FindRangeIntervals(
+					std::max(start,begin)-begin, std::min(end,finish)-begin))
+					spans.push_back(part.Offset(TileSpan(begin,finish).left));
+			}
+		};
+		append(first);
+		if (first+1<last)
+			spans.push_back(TileSpan(Boundary(first+1),Boundary(last)));
+		if (first!=last) append(last);
+		std::sort(spans.begin(),spans.end(),[](Interval a,Interval b){ return a.left<b.left; });
+		return spans;
+	}
+
+	bool DrawRange(Surface *drawing, PRectangle clip, XYPOSITION x, XYPOSITION y, ColourRGBA colour,
+		size_t start, size_t end) override {
+		if (start>=end || clip.Empty()) return true;
+		const size_t left = TileAtX(clip.left-x), right = TileAtX(clip.right-x);
+		const size_t first = std::max(TileAt(start),std::min(left,right));
+		const size_t last = std::min(TileAt(end-1),std::max(left,right));
+		for (size_t i=first; i<=last; ++i) {
+			const auto tile = Tile(i);
+			const size_t begin = tile.start-line.start;
+			if (!tile.Shape(surface)->DrawRange(drawing,clip,x+TileSpan(begin,begin+tile.len).left,y,colour,
+				std::max(start,begin)-begin,std::min(end,begin+tile.len)-begin))
+				return false;
+		}
+		return true;
+	}
+};

+			first = std::min(first,it->glyph);
+			last = std::max(last,it->glyph);
+			++it;
+		}
+		CTRunDraw(run,context,CFRangeMake(first,last-first+1));
+	}
+	CGContextRestoreGState(context);
+	return true;

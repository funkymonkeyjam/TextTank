 // Bidirectional text support for Arabic and Hebrew.
 
+bool SurfaceImpl::BidiBaseRightToLeft(std::string_view text) const {
+	static NSRegularExpression *strong = [NSRegularExpression regularExpressionWithPattern:
+		@"(\\p{Bidi_Class=L})|([\\p{Bidi_Class=R}\\p{Bidi_Class=AL}])|([\\x{2066}-\\x{2068}])|(\\x{2069})" options:0 error:nil];
+	NSUInteger isolateDepth = 0;
+	while (!text.empty()) {
+		size_t n = std::min<size_t>(text.size(),4096);
+		while (n < text.size() && UTF8IsTrailByte(text[n])) --n;
+		NSString *chunk = [[NSString alloc] initWithBytes:text.data() length:n encoding:NSUTF8StringEncoding];
+		if (!chunk) return false;
+		NSRange rest = NSMakeRange(0,chunk.length);
+		while (rest.length) {
+			NSTextCheckingResult *match = [strong firstMatchInString:chunk options:0 range:rest];
+			if (!match) break;
+			if ([match rangeAtIndex:3].location!=NSNotFound) ++isolateDepth;
+			else if ([match rangeAtIndex:4].location!=NSNotFound) {
+				if (isolateDepth) --isolateDepth;
+			} else if (!isolateDepth) return [match rangeAtIndex:2].location!=NSNotFound;
+			const NSUInteger next = NSMaxRange(match.range);
+			rest = NSMakeRange(next,chunk.length-next);
+		}
+		text.remove_prefix(n);
+	}
+	return false;
+}
+
+size_t SurfaceImpl::BidiSubdivision(std::string_view text, size_t offset, bool rtl) const {
+	// Keep short opposite-direction words together at artificial boundaries.
+	// Prefer separators, then a base-direction letter close to the nominal cut.
+	const size_t min = offset > 256 ? offset-256 : 1;
+	const size_t max = std::min(text.size()-1,offset+256);
+	size_t best = offset, bestDistance = 257;
+	int bestRank = 0;
+	for (size_t i=min;i<=max;) {
+		const auto ch = static_cast<unsigned char>(text[i]);
+		const auto n = UTF8DrawBytes(text.data()+i,text.size()-i);
+		const size_t distance = i>offset ? i-offset : offset-i;
+		const bool latin = (ch>='A' && ch<='Z') || (ch>='a' && ch<='z');
+		const auto cp = UTF8IsAscii(ch) ? ch : UnicodeFromUTF8(text.substr(i));
+		const bool hebrewOrArabic = (cp>=0x05d0 && cp<=0x05ea) || (cp>=0x0620 && cp<=0x064a);
+		const bool baseLetter = rtl ? hebrewOrArabic : latin;
+		const int rank = ch==' ' ? 2 : baseLetter ? 1 : 0;
+		if (rank && (rank>bestRank || (rank==bestRank && distance<bestDistance))) {
+			best=i; bestRank=rank; bestDistance=distance;
+		}
+		i += n;
+	}
+	offset=best;
+	while (offset && UTF8IsTrailByte(text[offset]))
+		--offset;
+	// Ask Foundation for a composed-character boundary in a bounded
+	// neighborhood. Never split a UTF-8 scalar even in pathological input.
+	size_t begin = offset > 256 ? offset-256 : 0;
+	size_t end = std::min(text.size(),offset+256);
+	while (begin && UTF8IsTrailByte(text[begin])) --begin;
+	while (end<text.size() && UTF8IsTrailByte(text[end])) ++end;
+	NSString *context = [[NSString alloc] initWithBytes:text.data()+begin length:end-begin encoding:NSUTF8StringEncoding];
+	if (!context) return offset;
+	const NSUInteger index = UTF16Length(text.substr(begin,offset-begin));
+	const NSRange cluster = [context rangeOfComposedCharacterSequenceAtIndex:index];
+	return begin + UTF8PositionFromUTF16Position(text.substr(begin,end-begin),cluster.location);
+}
+
+bool SurfaceImpl::NeedsBidiLayout(std::string_view text) const {
+	// The Unicode bidi controls and script blocks containing strong RTL letters.
+	// False positives only request shaping; CoreText resolves the actual runs.
+	for (size_t offset = 0; offset < text.size();) {
+		if (UTF8IsAscii(text[offset])) { ++offset; continue; }
+		const auto tail = text.substr(offset);
+		const int status = UTF8Classify(tail);
+		if (status & UTF8MaskInvalid)
+			return false;
+		const int cp = UnicodeFromUTF8(tail);
+		if ((cp >= 0x0590 && cp <= 0x08ff) || cp == 0x200f ||
+			(cp >= 0x202a && cp <= 0x202e) || (cp >= 0x2066 && cp <= 0x2069) ||
+			(cp >= 0xfb1d && cp <= 0xfdff) || (cp >= 0xfe70 && cp <= 0xfefc) ||
+			(cp >= 0x10800 && cp <= 0x10fff) || (cp >= 0x1e800 && cp <= 0x1efff))
+			return UTF8IsValid(tail);
+		offset += status & UTF8MaskWidth;
+	}
+	return false;
+}

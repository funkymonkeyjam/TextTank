+// NSString's UTF-8 decoder consumes an initial BOM. These bytes are already
+// document text, including at substring boundaries, so retain every U+FEFF.
+static NSString *StringFromLineBytes(std::string_view text) {
+	size_t signatures = 0;
+	while (text.size() >= 3 && text.substr(0,3) == "\xEF\xBB\xBF") {
+		++signatures;
+		text.remove_prefix(3);
+	}
+	NSString *body = [[NSString alloc] initWithBytes:text.data() length:text.size() encoding:NSUTF8StringEncoding];
+	if (!signatures || !body) return body;
+	NSString *prefix = [@"" stringByPaddingToLength:signatures withString:@"\uFEFF" startingAtIndex:0];
+	return [prefix stringByAppendingString:body];
+}

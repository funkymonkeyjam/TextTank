+std::vector<BidiLevelRun> SurfaceImpl::BidiLevels(std::string_view text, bool rtl, size_t tileBytes) const {
+	// Resolve the paragraph without creating glyphs or a CTTypesetter. The transient
+	// UTF-16 levels are compressed to runs; native shaping remains viewport-local.
+	NSString *string = StringFromLineBytes(text);
+	if (!string) return {{0, static_cast<unsigned char>(rtl)}};
+	NSAttributedString *paragraph = [[NSAttributedString alloc] initWithString:string];
+	std::vector<uint8_t> levels(string.length, rtl ? 1 : 0);
+	CFAttributedStringGetBidiLevelsAndResolvedDirections((__bridge CFAttributedStringRef)paragraph,
+		CFRangeMake(0, string.length), rtl ? NSWritingDirectionRightToLeft : NSWritingDirectionLeftToRight,
+		levels.data(), nullptr);
+	// A strong character resolved at the paragraph base is a safe restart.
+	// Pack those independent short spans into a single native tile, avoiding
+	// a retained descriptor per character in alternating Latin/Hebrew text.
+	struct Boundary { size_t byte, character; };
+	std::vector<Boundary> anchors = {{0,0}};
+	static NSRegularExpression *const leftStrong = [NSRegularExpression regularExpressionWithPattern:@"\\p{Bidi_Class=L}" options:0 error:nil];
+	static NSRegularExpression *const rightStrong = [NSRegularExpression regularExpressionWithPattern:@"[\\p{Bidi_Class=R}\\p{Bidi_Class=AL}]" options:0 error:nil];
+	size_t nominal = tileBytes;
+	for (size_t byte = 0, character = 0; byte < text.size();) {
+		const auto bytes = UTF8DrawBytes(text.data()+byte, text.size()-byte);
+		while (byte > nominal+256) nominal += tileBytes;
+		if (byte+256 >= nominal && levels[character] == static_cast<uint8_t>(rtl)) {
+			const auto cp = UnicodeFromUTF8(text.substr(byte));
+			const bool asciiLetter = (cp>='a' && cp<='z') || (cp>='A' && cp<='Z');
+			const NSRange one = NSMakeRange(character, bytes==4 ? 2 : 1);
+			const bool baseStrong = cp < 0x80 ? (!rtl && asciiLetter) :
+				[(rtl ? rightStrong : leftStrong) rangeOfFirstMatchInString:string
+					options:NSMatchingAnchored range:one].location != NSNotFound;
+			if (baseStrong && [string rangeOfComposedCharacterSequenceAtIndex:character].location==character) {
+				anchors.push_back({byte,character});
+				nominal += tileBytes;
+			}
+		}
+		character += bytes==4 ? 2 : 1;
+		byte += bytes;
+	}
+	anchors.push_back({text.size(),string.length});
+	std::vector<BidiLevelRun> runs;
+	for (size_t i=1; i<anchors.size(); ++i) {
+		auto [byte,character] = anchors[i-1];
+		const size_t end = anchors[i].byte;
+		if (end-byte <= tileBytes+512) {
+			runs.push_back({byte,static_cast<unsigned char>(rtl),false});
+			continue;
+		}
+		while (byte<end) {
+			const auto level = levels[character];
+			if (byte==anchors[i-1].byte || level!=runs.back().level)
+				runs.push_back({byte,level});
+			const auto bytes = UTF8DrawBytes(text.data()+byte,text.size()-byte);
+			character += bytes==4 ? 2 : 1;
+			byte += bytes;
+		}
+	}
+	return runs;
 }
 

+// The fixed-pitch shortcut is valid only when every displayed byte is an independent,
+// visible cell with the same measured advance. Other lines use the full layout below.
+XYPOSITION UniformASCIIAdvance(const LineLayout &ll, int length, const ViewStyle &vs,
+	const SpecialRepresentations &representations) noexcept {
+	if (length < 1024 * 1024 || ll.bidiText)
+		return 0;
+	const Style &style = vs.styles[ll.styles[0]];
+	if (!style.monospaceASCII || !style.visible || style.italic || style.hotspot ||
+		static_cast<XWidth>(style.spaceWidth) != static_cast<XWidth>(style.monospaceCharacterWidth))
+		return 0;
+	for (unsigned char ch = ' '; ch <= '~'; ++ch) {
+		if (representations.MayContain(ch))
+			return 0;
+	}
+	if (std::memcmp(ll.styles.get(), ll.styles.get() + 1, length - 1))
+		return 0;
+	for (int i = 0; i < length; ++i) {
+		const unsigned char ch = ll.chars[i];
+		if (ch < ' ' || ch > '~')
+			return 0;
+	}
+	return static_cast<XWidth>(style.monospaceCharacterWidth);
+}
+
+// A style-clock change can request verification even when the bytes are untouched.
+// Read across the document gap using the same bounded range API as initial layout.
+bool CachedBytesMatch(const LineLayout &ll, const Document &doc, Sci::Position start, Sci::Position length) {
+	char chars[8192];
+	unsigned char styles[sizeof(chars)];
+	for (Sci::Position offset = 0; offset < length;) {
+		const auto count = std::min<Sci::Position>(sizeof(chars), length - offset);
+		doc.GetCharRange(chars, start + offset, count);
+		doc.GetStyleRange(styles, start + offset, count);
+		if (std::memcmp(chars, ll.chars.get() + offset, count) ||
+			std::memcmp(styles, ll.styles.get() + offset, count))
+			return false;
+		offset += count;
+	}
+	return true;
+}

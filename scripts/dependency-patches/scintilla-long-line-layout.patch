+ForwardRange VisibleASCIICells(const LineLayout &ll, ForwardRange range, Interval clip,
+	XYPOSITION offset, const ViewStyle &style) {
+	if (!ll.uniformASCII || range.Empty() || style.viewWhitespace != WhiteSpace::Invisible ||
+		style.viewIndentationGuides == IndentView::Real)
+		return range;
+	// Allow adjacent cells to overhang. Off-screen bytes cannot affect shaping on this path.
+	const Range bounds(range);
+	const auto first = std::max<Sci::Position>(range.First(), ll.FindBefore(clip.left - offset, bounds) - 2);
+	const auto last = std::min<Sci::Position>(range.Last(), ll.FindBefore(clip.right - offset, bounds) + 3LL);
+	return ForwardRange(first, last);
+}

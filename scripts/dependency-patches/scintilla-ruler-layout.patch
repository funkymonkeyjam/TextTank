+static void SetTextForeground(QuartzTextStyle *style, ColourRGBA fore) {
+	CGColorRef color = CGColorCreateGenericRGB(fore.GetRedComponent(),
+						   fore.GetGreenComponent(),
+						   fore.GetBlueComponent(),
+						   fore.GetAlphaComponent());
+
+	style->setCTStyleColour(color);
+
+	CGColorRelease(color);
+}
+
+void SurfaceImpl::DrawTextRightAligned(PRectangle rc, const Font *font_, XYPOSITION ybase, std::string_view text,
+        ColourRGBA fore, ColourRGBA back, XYPOSITION padding) {
+	QuartzTextStyle *style = TextStyleFromFont(font_);
+	if (!style) {
+		Surface::DrawTextRightAligned(rc, font_, ybase, text, fore, back, padding);
+		return;
+	}
+	SetTextForeground(style, fore);
+	QuartzTextLayout layout(text, EncodingFromCharacterSet(UnicodeMode(), style->getCharacterSet()), style);
+	rc.left = rc.right - layout.MeasureStringWidth() - padding;
+	FillRectangleAligned(rc, back);
+	layout.draw(gc, rc.left, ybase);
+}

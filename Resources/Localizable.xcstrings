{
  "sourceLanguage": "en",
  "strings": {
    "automation.advanced.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Edit the JSON below. Rename by changing name and keeping id unchanged. Input: selection, document, clipboard, file. Output: editor, clipboard, newDocument, file, reminders, previewChanges. Each entry of steps has a kind from the list below and only the fields that kind takes. Set askForFind or askForReplacement true to be asked for that text on every run. Optional shortcut: one lowercase letter, bound to Command-Option. Set previewBeforeApply true for a preview before the result is applied. Set pinToToolbar true to mark the automation as a favorite. Favorites appear first in the Automations drop-down and the editor context menu. The menu bar and Run Automation list keep the saved order. No automation runs when saved or imported."
          }
        }
      }
    },

  "native_changes": [
    "Remove unused windows.h; replace decimal _itoa with bounded snprintf",
    "Local WordList facade supplies StartAt/reordering without changing pinned dependency ABI",
    "Port MatchIgnoreCase2 to local helper",
    "Own 15 UDL keyword lists rather than indexing upstream 9-list LexerBase storage",
    "Per-lexer generated cache identifiers replace pointer truncation; Release erases cache entries"
  ],
  "limitations": [
    "Native semantic fixtures cover keywords, ignore-case, comments and delimiters; complete UDL feature matrix remains open",
    "Case matching retains upstream byte-oriented behavior; Unicode case equivalence is not certified",
    "Imported style RGB is retained; native dynamic semantic palette adapts light/dark; exact UDL colorStyle/font face/size parity remains open"
  ]
}
